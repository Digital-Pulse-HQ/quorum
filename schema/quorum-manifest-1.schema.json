{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quorum:schema:quorum-manifest-1.schema.json",
  "title": "quorum-manifest/1 — merge-gate input",
  "description": "This schema is the merge-gate contract, distinct from quorum-fixtures/1. A case here has no `expect` or `kind` field, because gate mode requires every case's verification result to be ok:true — a manifest cannot declare its own refusal as the required outcome. additionalProperties is false, so a manifest carrying fixture-conformance metadata (expect, kind, description, origin) is refused by this schema rather than silently accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "quorum-manifest/1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "envelope", "policy", "trust", "artifact", "evidence", "attempt", "commit", "pr"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]{0,127}$" },
          "envelope": { "type": "string" },
          "policy": { "type": "string" },
          "trust": { "type": "string" },
          "artifact": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] },
          "attempt": { "type": "string", "pattern": "^attempt:[a-f0-9]{32}$" },
          "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
          "pr": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
